# Browser: same-origin BFF under /api (recommended: leave public URL as /api or site origin).
NEXT_PUBLIC_API_BASE_URL=/api

# Server-side BFF → Nest API (use a different port than Next dev, e.g. API 3000, Next 3001).
BACKEND_API_URL=http://localhost:3000

NEXT_PUBLIC_AUTH_MODE=optional

# Match whaterakt_backend FEATURE_INBOX_ENABLED / FEATURE_AUTOMATIONS_ENABLED (default: on).
# NEXT_PUBLIC_FEATURE_INBOX_ENABLED=false
# NEXT_PUBLIC_FEATURE_AUTOMATIONS_ENABLED=false

# Optional server-only mirrors of backend FEATURE_* (same values as whaterakt_backend/.env).
# When set, the BFF returns 503 if they disagree with the NEXT_PUBLIC_* lines above.
# FEATURE_INBOX_ENABLED=true
# FEATURE_AUTOMATIONS_ENABLED=true
